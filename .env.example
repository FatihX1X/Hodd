# Circle testnet Developer Services credentials. Copy this file to .env.local.
# Never commit .env.local, an entity secret, recovery file, OTP, seed phrase, or private key.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ADDRESS=

# Real Arc Testnet Earn writes are allowed only under `next dev` on localhost.
HODD_EARN_EXECUTION_ENABLED=false

# Optional read-only RPC override. The public Arc Testnet RPC is used by default.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
