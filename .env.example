# Copy this file to git-ignored .env.local for development.
# Never commit .env.local, an entity secret, recovery file, OTP, seed phrase, or private key.
CIRCLE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Shared developer-wallet signing has been retired. Entity secret is not needed.

# Optional read-only RPC override. The public Arc Testnet RPC is used by default.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
