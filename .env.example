# Copy this file to git-ignored .env.local for development.
# Never commit .env.local, an entity secret, recovery file, OTP, seed phrase, or private key.
CIRCLE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Experimental user-owned Earn only. Never enabled in production/Vercel.
# Each provider still requires a live, user-approved testnet verification.
HODD_EARN_EXECUTION_ENABLED=false

# Server-only payment ledger writer. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Stage 5 also requires provider live verification; this flag alone cannot unlock Send.
HODD_PAYMENT_EXECUTION_ENABLED=false

# Shared developer-wallet signing has been retired. Entity secret is not needed.

# Optional read-only RPC override. The public Arc Testnet RPC is used by default.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Optional local-development test signer (next dev only). Put real values in .env.development.local, never here.
# HODD_TEST_SIGNER_ENABLED=true
# HODD_TEST_SIGNER_PRIVATE_KEY=
