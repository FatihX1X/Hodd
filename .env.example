# Copy this file to git-ignored .env.local for development.
# Never commit .env.local, an entity secret, recovery file, OTP, seed phrase, or private key.
CIRCLE_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# Local development execution (next dev on loopback only). Hosted builds ignore these.
HODD_EARN_EXECUTION_ENABLED=false
HODD_PAYMENT_EXECUTION_ENABLED=false

# Hosted live Arc Testnet execution. Set to true ONLY in the Vercel Production scope;
# it opens solely on app.hoddfinance.xyz and the database kill switch can pause it.
HODD_TESTNET_LIVE=false

# Server-only writer for quotes, executions, leases and the payment ledger. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Shared developer-wallet signing has been retired. Entity secret is not needed.

# Optional https RPC override for every server read and receipt check. The public Arc Testnet RPC is the default.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Optional local-development test signer (next dev only). Put real values in .env.development.local, never here.
# HODD_TEST_SIGNER_ENABLED=true
# HODD_TEST_SIGNER_PRIVATE_KEY=

# Stage 6 Claude connector: HMAC secret for write confirmations (32+ random characters). Server only.
# HODD_MCP_HANDLE_SECRET=

# Hoddie: server-only keys. Never use NEXT_PUBLIC_ for an AI provider key.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Set true only after verifying that this Gemini project uses the unpaid tier.
HODDIE_GEMINI_FREE_TIER_CONFIRMED=false
# Optional free-tier Flash model override, after verifying project eligibility.
# HODDIE_GEMINI_MODEL=gemini-3.8-flash
# Hoddie confirmations also require an existing server-only SUPABASE_SECRET_KEY,
# CIRCLE_API_KEY, or HODD_MCP_HANDLE_SECRET (32+ characters). No signing key is requested.

# Autopilot AI advisor (server only). A Groq key turns the advisor on for every Autopilot, inside the engine's
# limits. The operator switch is the AGENT_ADVISOR row in hodd_live_controls (missing = off).
GROQ_API_KEY=
# AUTOPILOT_GROQ_MODEL=openai/gpt-oss-120b
# Bearer secret for the hourly Supabase scheduler tick (same value as Vault secret 'autopilot_scheduler_secret').
# CRON_SECRET (Vercel's daily cron) keeps working as well.
AUTOPILOT_SCHEDULER_SECRET=

# Landing page: a public https link to the demo video. Empty hides the "Watch the demo" button in the hero.
# HODD_DEMO_VIDEO_URL=
